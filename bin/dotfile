#!/usr/bin/env python3
import sys
import Command
import Dotfile as DF
from Dotfile import Dotfile, Dotfiles, DotfileExecuter

DF.Dotfile_local_home = '/home/josh'
dotfiles = Dotfiles([
    Dotfile(
        name = 'DankMaterialShell',
        path = '~/.config/DankMaterialShell/',
        local_path = '~/dotfiles/DankMaterialShell/',
        files = [
            'settings.json'
        ],
    ),
    Dotfile(
        name = 'wofi',
        path = '~/.config/wofi/',
        local_path='~/dotfiles/wofi/',
        files = [
            'config'
        ],
    ),
    Dotfile(
        name = 'waybar',
        path = '~/.config/waybar/',
        local_path='~/dotfiles/waybar/',
        files = [
            'config',
            'style.css'
        ]
    ),
    Dotfile(
        name = 'awesome',
        path = '~/.config/awesome/',
        local_path = '~/dotfiles/awesome/',
        files = [
            'rc.lua',
            ('theme.lua', 'themes/default/theme.lua')
        ],
        extra_cmds = [
            ['cp', '-r', '/usr/share/awesome/icons', '~/.config/awesome/'],
            ['cp', '-r', '/usr/share/awesome/themes/default/taglist', '~/.config/awesome/themes/default/']
        ],
        install_all=False
    ),
    Dotfile(
        name = 'hyprland_old',
        path = '~/.config/hypr/',
        local_path = '~/dotfiles/hyprland/',
        files = [
            'hyprland.conf',
            'keybinds.conf'
        ],
        install_all=False
    ),
    Dotfile(
        name = 'hyprland',
        path = '~/.config/hypr/',
        local_path = '~/dotfiles/hyprland/',
        files = [
            'hyprland.lua',
            'keybinds.lua',
        ]
    ),
    Dotfile(
        name = 'niri',
        path = '~/.config/niri/',
        local_path = '~/dotfiles/niri',
        files = [
            'config.kdl',
            'dms/alttab.kdl',
            'dms/binds.kdl',
            'dms/colors.kdl',
            'dms/cursor.kdl',
            'dms/layout.kdl',
            'dms/outputs.kdl',
            'dms/windowrules.kdl',
            'dms/wpblur.kdl'
        ],
        install_all=False
    ),
    Dotfile(
        name = 'dunst',
        path = '~/.config/dunst',
        local_path = '~/dotfiles/dunst',
        files = [
            'dunstrc'
        ]
    ),
    Dotfile(
        name = 'quickshell',
        path = '~/.config/quickshell',
        local_path='~/dotfiles/quickshell',
        files = []
    ),
    Dotfile(
        name = 'udev',
        path = '/usr/udev/rules.d',
        local_path = '~/dotfiles/udev',
        files = [
            '99-Donner_Drums_MIDI.rules'
        ]
    ),
    Dotfile('.bashrc'),
    Dotfile('.vimrc'),
    Dotfile('.xinitrc'),
    Dotfile('.Xresources'),
    Dotfile('.zshrc'),
    Dotfile('.bash_profile')
])

def main():
    DotfileExecuter.dotfile_list = dotfiles
    Command.Command(sys.argv, DotfileExecuter.fn_map)
    
if __name__ == '__main__':
    main()
